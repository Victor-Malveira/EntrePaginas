{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:|(?:index|cadastro|carrinho|finalizar|login|logout|meus_pedidos|pedido|produto|privacidade)\\.php)$",
      "dest": "/api/index.php"
    }
  ]
}
