{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "^/(css|js)/([a-zA-Z0-9_.-]+)$",
      "dest": "/$1/$2"
    },
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/(index|cadastro|carrinho|finalizar|login|logout|meus_pedidos|pedido|produto|privacidade)\\.php$",
      "dest": "/api/index.php"
    }
  ]
}
